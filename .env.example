# Copy to .env.local to point the app at a submission worker.
#
# Leave it unset and the app still works: the send button and the inbox link
# simply do not appear, and every other way of moving the answers stays in
# place. See docs/SETUP_WORKER.md.
#
# Note that setting this in .env.local also affects `npm run e2e`, which builds
# the site before running.
VITE_SUBMIT_ENDPOINT=https://brand-tone-submit.YOURNAME.workers.dev
